# vhs demo/minis.tape && python3 demo/minis.py  (run from the repo root)
Output demo/.minis-raw.gif

Set FontSize 21
Set FontFamily "Menlo"
Set Width 1250
Set Height 260
Set Padding 14
Set Theme { "name": "demo", "background": "#0f1c1e", "foreground": "#b8c7c7", "cursor": "#0f1c1e", "black": "#0f1c1e", "red": "#ff5757", "green": "#50c8a0", "yellow": "#ffbf40", "blue": "#4db2d6", "magenta": "#a8748c", "cyan": "#4db2d6", "white": "#d9e0e0", "brightBlack": "#587b7b", "brightRed": "#ff5757", "brightGreen": "#50c8a0", "brightYellow": "#ffbf40", "brightBlue": "#4db2d6", "brightMagenta": "#a8748c", "brightCyan": "#4db2d6", "brightWhite": "#eef2f2" }

Hide
Type "bash demo/drive.sh minis && tmux -L claude-demo attach -t work"
Enter
Sleep 1s
Show
Sleep 22s
Hide
Ctrl+B
Type "d"
Sleep 500ms
Type "bash demo/drive.sh down"
Enter
